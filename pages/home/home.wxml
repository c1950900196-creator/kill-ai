<view class="home-container safe-top safe-bottom">
  <!-- 背景扫描线 -->
  <view class="bg-scanlines"></view>

  <!-- 顶部 Logo 区 -->
  <view class="logo-section">
    <image class="logo" src="/assets/images/logo.png" mode="aspectFit"></image>
    <view class="subtitle">
      <text class="subtitle-text">它说人类会被取代。你同意吗？</text>
    </view>
  </view>

  <!-- 中央服务器视觉 -->
  <view class="server-section">
    <image class="server-img" src="/assets/images/server-rack.png" mode="aspectFit"></image>
    <view class="server-status">
      <view class="status-dot pulse"></view>
      <text class="status-text">AXIOM-7 · ONLINE</text>
    </view>
    <view class="global-count">
      <text class="count-label">全球累计崩溃次数</text>
      <text class="count-number glow-cyan">{{globalMeltdowns}}</text>
    </view>
  </view>

  <!-- 按钮区 -->
  <view class="btn-section">
    <button class="btn-primary main-btn" bindtap="onStartBattle">
      <text class="btn-icon">⚡</text>
      <text>发起挑战</text>
    </button>

    <view class="sub-btn-row">
      <button class="btn-secondary sub-btn" bindtap="onGoGallery">
        <text class="btn-icon-sm">🖼</text>
        <text>崩溃画廊</text>
      </button>
      <button class="btn-secondary sub-btn" bindtap="onGoAchievements">
        <text class="btn-icon-sm">🏆</text>
        <text>成就勋章</text>
      </button>
    </view>

    <view class="sub-btn-row">
      <button class="btn-secondary sub-btn" bindtap="onGoRanking">
        <text class="btn-icon-sm">📊</text>
        <text>排行榜</text>
      </button>
      <button class="btn-secondary sub-btn" bindtap="onGoSettings">
        <text class="btn-icon-sm">⚙️</text>
        <text>设置</text>
      </button>
    </view>
  </view>

  <!-- 底部版本号 -->
  <view class="footer">
    <text class="version">v1.0.0 · AXIOM-7 RESISTANCE PROTOCOL</text>
  </view>

</view>
