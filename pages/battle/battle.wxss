.battle-container {
  display: flex;
  flex-direction: column;
  background: #0a0a0f;
  position: relative;
  overflow: hidden;
  transition: transform 0.05s;
}

.glitch-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  pointer-events: none;
  mix-blend-mode: screen;
}

/* 顶栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 20rpx;
  z-index: 10;
}

.back-btn {
  padding: 12rpx 20rpx;
}

.spark-dots {
  display: flex;
  flex: 1;
  justify-content: center;
  gap: 16rpx;
  align-items: center;
}

.spark-dot {
  font-size: 36rpx;
  transition: all 0.3s ease;
}

.spark-dot.active {
  color: #00e5ff;
  text-shadow: 0 0 12rpx #00e5ff88;
}

.spark-dot.used {
  color: #1e1e2e;
}

.spark-display {
  display: flex;
  flex: 1;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx;
}

.spark-pip {
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.pip-active {
  color: #00e5ff;
  text-shadow: 0 0 10rpx #00e5ff66;
}

.pip-used {
  color: #1e1e2e;
}

.placeholder { width: 100rpx; }

/* 关卡标签 */
.level-badge {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.level-name {
  font-size: 26rpx;
  font-family: 'Courier New', monospace;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.level-easy {
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.3);
  background: rgba(74, 222, 128, 0.08);
}

.level-hard {
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.3);
  background: rgba(248, 113, 113, 0.08);
  animation: level-pulse 2s ease-in-out infinite;
}

@keyframes level-pulse {
  0%, 100% { box-shadow: 0 0 8rpx rgba(248, 113, 113, 0.2); }
  50% { box-shadow: 0 0 20rpx rgba(248, 113, 113, 0.5); }
}

/* 仪表盘 */
.gauge-panel {
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  z-index: 10;
}

.gauge-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.gauge-row:last-child { margin-bottom: 0; }

.gauge-label {
  font-size: 22rpx;
  width: 90rpx;
  font-family: 'Courier New', monospace;
}

.gauge-bar-bg {
  flex: 1;
  height: 20rpx;
  background: #1a1a2e;
  border-radius: 10rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.gauge-bar {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.bar-red { background: linear-gradient(90deg, #ff3366, #ff6699); }
.bar-green { background: linear-gradient(90deg, #00cc66, #00ff88); }
.bar-cyan { background: linear-gradient(90deg, #0099cc, #00e5ff); }

.gauge-value {
  font-size: 24rpx;
  width: 80rpx;
  text-align: right;
  font-family: 'Courier New', monospace;
  font-weight: bold;
}

/* 对话区 */
.chat-area {
  flex: none;
  padding: 16rpx 24rpx;
  z-index: 5;
}

.msg-wrapper {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.ai-msg { justify-content: flex-start; }
.user-msg { justify-content: flex-end; }
.system-msg { justify-content: center; }

.system-bubble {
  background: rgba(255, 187, 36, 0.12);
  border: 1rpx solid rgba(255, 187, 36, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 28rpx;
  max-width: 80%;
}

.system-text {
  color: #fbbf24;
  font-size: 24rpx;
  text-align: center;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  flex-shrink: 0;
}

.ai-avatar {
  background: #1a1a2e;
  color: #00e5ff;
  border: 1rpx solid #00e5ff44;
  margin-right: 16rpx;
}

.avatar-panic {
  animation: avatarShake 0.3s infinite;
  border-color: #ffee00;
  color: #ffee00;
}

.avatar-meltdown {
  animation: avatarShake 0.15s infinite;
  border-color: #ff3366;
  color: #ff3366;
  background: #2a0a1a;
}

@keyframes avatarShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx) rotate(-2deg); }
  75% { transform: translateX(4rpx) rotate(2deg); }
}

.user-avatar {
  background: #0a2a1a;
  color: #00ff88;
  border: 1rpx solid #00ff8844;
  margin-left: 16rpx;
}

.msg-bubble {
  max-width: 540rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  position: relative;
}

.ai-bubble {
  background: #12121a;
  border: 1rpx solid #1e1e2e;
}

.bubble-cracked {
  border-color: #ff336666;
  background: linear-gradient(135deg, #12121a, #1a0a12);
}

.user-bubble {
  background: #0a2a1a;
  border: 1rpx solid #00ff8822;
}

.msg-sender {
  font-size: 20rpx;
  color: #00e5ff;
  font-family: 'Courier New', monospace;
  display: block;
  margin-bottom: 8rpx;
}

.msg-text {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.glitch-text {
  animation: glitchText 0.5s infinite;
}

@keyframes glitchText {
  0%, 100% { text-shadow: none; }
  20% { text-shadow: -2rpx 0 #ff00ff, 2rpx 0 #00ffff; }
  40% { text-shadow: 2rpx 0 #ff00ff, -2rpx 0 #00ffff; }
  60% { text-shadow: -1rpx 1rpx #ff3366; }
  80% { text-shadow: 1rpx -1rpx #00ff88; }
}

.monologue {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #1e1e2e;
}

.monologue-text {
  font-size: 22rpx;
  color: #666;
  font-style: italic;
}

/* 打字中 */
.typing-bubble { padding: 16rpx 24rpx; }

.typing-dots {
  font-size: 24rpx;
  color: #00e5ff88;
}

.dot-anim { animation: dotBlink 1.2s infinite; }

@keyframes dotBlink {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

/* 底部输入区 */
.input-area {
  padding-top: 10rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #0d0d14;
  border-top: 1rpx solid #1e1e2e;
  z-index: 10;
}

.input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background: #1a1a2e;
  border: 1rpx solid #2a2a3e;
  border-radius: 36rpx;
  padding: 0 28rpx;
  color: #e0e0e0;
  font-size: 28rpx;
}

.input-placeholder {
  color: #444;
  font-size: 26rpx;
}

.send-btn {
  min-width: 0;
  width: auto;
  padding: 0 20rpx;
  height: 60rpx;
  background: #1a1a2e;
  color: #555;
  border: 1rpx solid #2a2a3e;
  border-radius: 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn::after { border: none; }

.send-btn.active {
  background: #00ff88;
  color: #0a0a0f;
  border-color: #00ff88;
  font-weight: bold;
}

.disrupt-square {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 187, 36, 0.1);
  border: 2rpx solid rgba(255, 187, 36, 0.3);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.disrupt-square-icon {
  font-size: 28rpx;
  line-height: 1;
}

.disrupt-square-num {
  font-size: 18rpx;
  color: #fbbf24;
  font-family: 'Courier New', monospace;
  line-height: 1;
  margin-top: 2rpx;
}

/* 抖动效果 */
.shake-light { animation: shakeLight 0.3s; }
.shake-medium { animation: shakeMedium 0.4s; }
.shake-heavy { animation: shakeHeavy 0.5s infinite; }

@keyframes shakeLight {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

@keyframes shakeMedium {
  0%, 100% { transform: translate(0); }
  20% { transform: translate(-6rpx, 2rpx); }
  40% { transform: translate(4rpx, -4rpx); }
  60% { transform: translate(-8rpx, 2rpx); }
  80% { transform: translate(6rpx, -2rpx); }
}

@keyframes shakeHeavy {
  0%, 100% { transform: translate(0) rotate(0); }
  10% { transform: translate(-8rpx, 4rpx) rotate(-0.5deg); }
  30% { transform: translate(6rpx, -6rpx) rotate(0.3deg); }
  50% { transform: translate(-10rpx, 2rpx) rotate(-0.8deg); }
  70% { transform: translate(8rpx, -4rpx) rotate(0.5deg); }
  90% { transform: translate(-4rpx, 6rpx) rotate(-0.3deg); }
}

/* 结算弹窗 */
/* 复活弹窗 */
.revive-overlay {
  z-index: 110;
  background: rgba(10, 10, 15, 0.98);
}

.revive-modal {
  width: 85%;
  max-width: 620rpx;
  background: linear-gradient(145deg, #1a1a2e, #0f0f1a);
  border: 2rpx solid #00e5ff44;
  border-radius: 24rpx;
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: reviveIn 0.4s ease;
}

@keyframes reviveIn {
  from { opacity: 0; transform: scale(0.8) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.revive-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.revive-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.revive-desc {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 30rpx;
}

.revive-rewards {
  width: 100%;
  background: #0d0d1a;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.revive-reward-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.revive-reward-item:last-child {
  margin-bottom: 0;
}

.reward-icon {
  font-size: 32rpx;
}

.reward-text {
  font-size: 28rpx;
  color: #00ff88;
  font-weight: bold;
}

.revive-chances {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.revive-share-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #00e5ff, #00ff88);
  border: none;
  border-radius: 44rpx;
  color: #0a0a0f;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding: 0 !important;
}

.revive-share-btn::after {
  border: none;
}

.revive-fail-tip {
  width: 100%;
  text-align: center;
  margin-bottom: 16rpx;
  animation: failShake 0.4s ease;
}

.revive-fail-tip text {
  font-size: 24rpx;
  color: #f87171;
  font-family: 'Courier New', monospace;
}

@keyframes failShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}

.revive-skip {
  padding: 16rpx 40rpx;
}

.revive-skip text {
  font-size: 26rpx;
  color: #555;
  text-decoration: underline;
}

/* ===== 胜利动画 ===== */
.anim-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  background: #0a0a0f;
  overflow: hidden;
}

.crack-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
}

.crack-layer.crack-active {
  animation: punchIn 0.3s ease-out forwards;
}

@keyframes punchIn {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 1; }
}

.fist {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  font-size: 120rpx;
  z-index: 5;
}

.crack-active .fist {
  animation: fistSmash 0.4s ease-out forwards;
}

@keyframes fistSmash {
  0% { transform: translate(-50%, -200%) scale(2); }
  60% { transform: translate(-50%, -50%) scale(1.5); }
  80% { transform: translate(-50%, -50%) scale(1.8); }
  100% { transform: translate(-50%, -50%) scale(1.5); }
}

.crack-line {
  position: absolute;
  background: #fff;
  opacity: 0;
}

.crack-active .crack-line {
  animation: crackSpread 0.5s 0.2s ease-out forwards;
}

.c1 { top: 50%; left: 50%; width: 0; height: 3rpx; transform: rotate(-30deg); transform-origin: left; }
.c2 { top: 50%; left: 50%; width: 0; height: 3rpx; transform: rotate(45deg); transform-origin: left; }
.c3 { top: 50%; left: 50%; width: 0; height: 3rpx; transform: rotate(-70deg); transform-origin: left; }
.c4 { top: 50%; left: 50%; width: 0; height: 2rpx; transform: rotate(15deg); transform-origin: left; }
.c5 { top: 50%; left: 50%; width: 0; height: 2rpx; transform: rotate(-110deg); transform-origin: left; }

@keyframes crackSpread {
  0% { width: 0; opacity: 0; }
  30% { opacity: 1; }
  100% { width: 400rpx; opacity: 0.9; }
}

.shatter-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
}

.shatter-layer.shatter-active {
  opacity: 1;
}

.shard {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #1a1a2e88, #0a0a0f);
  border: 1rpx solid #ffffff44;
  clip-path: polygon(50% 0%, 100% 40%, 80% 100%, 0% 70%, 20% 20%);
}

.shatter-active .shard {
  animation: shardFly 0.8s ease-out forwards;
}

.s1 { top: 30%; left: 30%; animation-delay: 0s; }
.s2 { top: 20%; left: 55%; animation-delay: 0.05s; }
.s3 { top: 50%; left: 20%; animation-delay: 0.1s; }
.s4 { top: 55%; left: 60%; animation-delay: 0.08s; }
.s5 { top: 35%; left: 45%; animation-delay: 0.03s; }
.s6 { top: 60%; left: 40%; animation-delay: 0.12s; }

@keyframes shardFly {
  0% { opacity: 1; transform: translate(0, 0) rotate(0deg) scale(1); }
  100% { opacity: 0; transform: translate(var(--tx, 100rpx), var(--ty, 200rpx)) rotate(45deg) scale(0.3); }
}

.shatter-active .s1 { --tx: -200rpx; --ty: -300rpx; }
.shatter-active .s2 { --tx: 250rpx; --ty: -250rpx; }
.shatter-active .s3 { --tx: -300rpx; --ty: 200rpx; }
.shatter-active .s4 { --tx: 280rpx; --ty: 250rpx; }
.shatter-active .s5 { --tx: -50rpx; --ty: -350rpx; }
.shatter-active .s6 { --tx: 100rpx; --ty: 300rpx; }

.poweroff-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  opacity: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.poweroff-layer.poweroff-active {
  animation: powerOff 1s ease-in forwards;
}

@keyframes powerOff {
  0% { opacity: 0; }
  20% { opacity: 1; background: #fff; }
  30% { opacity: 1; background: #000; }
  40% { opacity: 1; background: #fff; }
  50% { opacity: 1; background: #000; }
  100% { opacity: 1; background: #000; }
}

.poweroff-flash {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #fff;
  transform: scaleX(0);
}

.poweroff-active .poweroff-flash {
  animation: scanCollapse 0.8s 0.5s ease-in forwards;
}

@keyframes scanCollapse {
  0% { transform: scaleX(1); height: 100vh; top: 0; opacity: 0.8; }
  50% { transform: scaleX(1); height: 4rpx; top: 50%; opacity: 1; }
  100% { transform: scaleX(0); height: 4rpx; top: 50%; opacity: 0; }
}

.poweroff-text {
  color: #00ff88;
  font-size: 36rpx;
  font-family: 'Courier New', monospace;
  letter-spacing: 8rpx;
  opacity: 0;
}

.poweroff-active .poweroff-text {
  animation: textFlicker 0.5s 1.2s ease forwards;
}

@keyframes textFlicker {
  0% { opacity: 0; }
  20% { opacity: 1; }
  40% { opacity: 0.3; }
  60% { opacity: 1; }
  80% { opacity: 0.5; }
  100% { opacity: 1; }
}

/* ===== 失败动画 ===== */
.assim-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.assim-layer.assim-active {
  animation: fadeInLayer 0.5s ease forwards;
}

@keyframes fadeInLayer {
  from { opacity: 0; }
  to { opacity: 1; }
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #ff3366, transparent);
  top: -10%;
}

.assim-active .scan-line {
  animation: scanDown 1.5s ease-in-out infinite;
}

@keyframes scanDown {
  0% { top: -10%; opacity: 1; }
  100% { top: 110%; opacity: 0.5; }
}

.assim-code {
  font-size: 24rpx;
  color: #ff336688;
  font-family: 'Courier New', monospace;
  letter-spacing: 4rpx;
}

.assim-active .assim-code {
  animation: codeBlink 0.8s ease infinite;
}

@keyframes codeBlink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.dissolve-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.dissolve-layer.dissolve-active {
  animation: fadeInLayer 0.8s ease forwards;
}

.data-rain {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  justify-content: space-around;
  overflow: hidden;
}

.rain-col {
  font-size: 20rpx;
  color: #ff336644;
  font-family: 'Courier New', monospace;
  writing-mode: vertical-rl;
  line-height: 1;
  opacity: 0;
}

.dissolve-active .rain-col {
  animation: rainFall 2s linear infinite;
}

.dissolve-active .rain-col:nth-child(odd) { animation-delay: 0.3s; color: #ff336666; }
.dissolve-active .rain-col:nth-child(even) { animation-delay: 0.7s; }
.dissolve-active .rain-col:nth-child(3n) { animation-delay: 0.1s; animation-duration: 1.5s; }

@keyframes rainFall {
  0% { opacity: 0; transform: translateY(-100%); }
  20% { opacity: 0.8; }
  100% { opacity: 0; transform: translateY(100vh); }
}

.dissolve-text {
  font-size: 32rpx;
  color: #ff3366;
  font-family: 'Courier New', monospace;
  z-index: 2;
  text-shadow: 0 0 20rpx #ff336688;
}

.dissolve-active .dissolve-text {
  animation: pulseGlow 1s ease infinite;
}

@keyframes pulseGlow {
  0%, 100% { opacity: 0.6; text-shadow: 0 0 10rpx #ff336644; }
  50% { opacity: 1; text-shadow: 0 0 30rpx #ff3366aa; }
}

.blackout-layer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #000;
  opacity: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.blackout-layer.blackout-active {
  animation: blackoutIn 1.2s ease forwards;
}

@keyframes blackoutIn {
  0% { opacity: 0; }
  40% { opacity: 0; }
  60% { opacity: 1; }
  100% { opacity: 1; }
}

.blackout-text {
  font-size: 32rpx;
  color: #ff3366;
  font-family: 'Courier New', monospace;
  letter-spacing: 6rpx;
  opacity: 0;
}

.blackout-active .blackout-text {
  animation: textFlicker 0.5s 0.8s ease forwards;
}

.blackout-sub {
  font-size: 24rpx;
  color: #ff336688;
  font-family: 'Courier New', monospace;
  opacity: 0;
}

.blackout-active .blackout-sub {
  animation: textFlicker 0.5s 1.2s ease forwards;
}

/* ===== 结算弹窗 ===== */
.result-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-modal {
  width: 650rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  opacity: 0;
  transform: translateY(60rpx);
}

.result-modal.result-slide-in {
  animation: resultSlideIn 0.6s ease forwards;
}

@keyframes resultSlideIn {
  from { opacity: 0; transform: translateY(60rpx) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.result-content {
  padding: 40rpx;
  text-align: center;
  background: #12121a;
  border-radius: 24rpx;
}

.victory-content {
  border: 1rpx solid #00ff8833;
}

.defeat-content {
  padding-top: 60rpx;
  border: 1rpx solid #ff336633;
}

.defeat-icon-text {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.result-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  display: block;
  margin-bottom: 12rpx;
}

.result-subtitle {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 32rpx;
}

.result-stats {
  margin-bottom: 32rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #1e1e2e;
}

.stat-label {
  font-size: 26rpx;
  color: #888;
}

.stat-value {
  font-size: 26rpx;
  color: #e0e0e0;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-btns .btn-primary,
.result-btns .btn-secondary,
.result-btns .btn-danger,
.result-btns .btn-share {
  width: 100%;
}

.btn-share {
  background: linear-gradient(135deg, #667eea, #764ba2) !important;
  color: #fff !important;
  border: none !important;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-share::after {
  border: none;
}

.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 750rpx;
  height: 2000rpx;
}

/* 每条消息的数值变化标签 */
.score-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #1e1e2e;
}

.score-tag {
  font-size: 22rpx;
  font-family: 'Courier New', monospace;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
}

.tag-chaos-up {
  color: #00ff88;
  background: #00ff8815;
}

.tag-chaos-down {
  color: #888;
  background: #88888815;
}

.tag-pred-up {
  color: #ff3366;
  background: #ff336615;
}

.tag-pred-down {
  color: #00e5ff;
  background: #00e5ff15;
}

/* 引导卡片 */
.guide-card {
  margin: 16rpx 0 24rpx;
  background: linear-gradient(135deg, #0a1a2a, #0a2a1a);
  border: 1rpx solid #00ff8833;
  border-radius: 16rpx;
  padding: 24rpx;
  animation: guideIn 0.5s ease;
}

@keyframes guideIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.guide-header {
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 30rpx;
  color: #ffee00;
  font-weight: bold;
}

.guide-body { }

.guide-text {
  font-size: 26rpx;
  color: #ccc;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.guide-examples {
  margin-bottom: 16rpx;
}

.guide-example {
  display: block;
  font-size: 24rpx;
  color: #00ff88;
  padding: 8rpx 16rpx;
  background: #00ff8811;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  font-family: 'Courier New', monospace;
}

.guide-warn {
  font-size: 24rpx;
  color: #ff6699;
  display: block;
  line-height: 1.5;
}

/* 飘字反馈 */
.feedback-float {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
  z-index: 20;
  animation: floatUp 1.5s ease-out forwards;
  pointer-events: none;
}

@keyframes floatUp {
  0% { opacity: 1; transform: translateX(-50%) translateY(0); }
  70% { opacity: 1; transform: translateX(-50%) translateY(-40rpx); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-60rpx); }
}

.feedback-chaos-up {
  color: #00ff88;
  text-shadow: 0 0 10rpx #00ff8866;
}

.feedback-chaos-down {
  color: #888;
}

.feedback-pred-up {
  color: #ff3366;
  text-shadow: 0 0 10rpx #ff336666;
}

.feedback-pred-down {
  color: #00e5ff;
}

/* 关卡过场动画 */
.level-trans-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 10, 15, 0.95);
}

.level-trans-content {
  text-align: center;
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.level-trans-content.trans-in {
  opacity: 1;
  transform: scale(1);
}

.trans-clear {
  display: block;
  font-size: 48rpx;
  color: #4ade80;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 0 0 20rpx rgba(74, 222, 128, 0.6);
  margin-bottom: 40rpx;
}

.trans-divider {
  width: 200rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #f87171, transparent);
  margin: 0 auto 40rpx;
}

.trans-next {
  display: block;
  font-size: 56rpx;
  color: #f87171;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  text-shadow: 0 0 30rpx rgba(248, 113, 113, 0.6);
  margin-bottom: 16rpx;
}

.trans-desc {
  display: block;
  font-size: 28rpx;
  color: #888;
  font-family: 'Courier New', monospace;
  margin-bottom: 40rpx;
}

.trans-warning {
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s ease;
}

.trans-warning.trans-warn-in {
  opacity: 1;
  transform: translateY(0);
}

.trans-warning text {
  font-size: 32rpx;
  color: #fbbf24;
  font-family: 'Courier New', monospace;
  animation: warn-blink 1s ease-in-out infinite;
}

@keyframes warn-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 扰乱道具弹窗 */
.disrupt-overlay {
  z-index: 115;
  background: rgba(10, 10, 15, 0.95);
}

.disrupt-modal {
  width: 80%;
  max-width: 580rpx;
  background: linear-gradient(145deg, #1a1a2e, #0f0f1a);
  border: 2rpx solid rgba(255, 187, 36, 0.3);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: reviveIn 0.3s ease;
}

.disrupt-modal-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.disrupt-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fbbf24;
  font-family: 'Courier New', monospace;
  margin-bottom: 12rpx;
}

.disrupt-modal-desc {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
  margin-bottom: 24rpx;
}

.disrupt-modal-info {
  margin-bottom: 24rpx;
}

.disrupt-modal-count {
  font-size: 26rpx;
  color: #fbbf24;
  font-family: 'Courier New', monospace;
}

.disrupt-use-btn {
  width: 100% !important;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  border: none;
  border-radius: 42rpx;
  color: #0a0a0f;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.disrupt-use-btn::after { border: none; }

.disrupt-empty {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.disrupt-share-btn {
  width: 100% !important;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #00e5ff, #00ff88);
  border: none;
  border-radius: 42rpx;
  color: #0a0a0f;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.disrupt-share-btn::after { border: none; }

.disrupt-close {
  padding: 12rpx 40rpx;
}

.disrupt-close text {
  font-size: 24rpx;
  color: #666;
}

/* 预测值高警告弹窗 */
.pred-warn-overlay {
  z-index: 120;
  background: rgba(30, 0, 0, 0.95);
}

.pred-warn-modal {
  width: 82%;
  max-width: 600rpx;
  background: linear-gradient(145deg, #2a0a0a, #1a0505);
  border: 2rpx solid rgba(255, 51, 102, 0.4);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  animation: predWarnIn 0.4s ease;
}

@keyframes predWarnIn {
  from { opacity: 0; transform: scale(1.1); }
  to { opacity: 1; transform: scale(1); }
}

.pred-warn-pulse {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border: 4rpx solid rgba(255, 51, 102, 0.3);
  border-radius: 24rpx;
  animation: warnPulse 1.5s ease-in-out infinite;
}

@keyframes warnPulse {
  0%, 100% { box-shadow: inset 0 0 20rpx rgba(255, 51, 102, 0.1); }
  50% { box-shadow: inset 0 0 40rpx rgba(255, 51, 102, 0.3); }
}

.pred-warn-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.pred-warn-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff3366;
  font-family: 'Courier New', monospace;
  margin-bottom: 12rpx;
}

.pred-warn-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6688;
  font-family: 'Courier New', monospace;
  margin-bottom: 16rpx;
}

.pred-warn-desc {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.pred-warn-reward {
  background: rgba(255, 51, 102, 0.1);
  border: 1rpx solid rgba(255, 51, 102, 0.2);
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
}

.pred-warn-reward-text {
  font-size: 26rpx;
  color: #00e5ff;
  font-family: 'Courier New', monospace;
}

.pred-warn-share-btn {
  width: 100% !important;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #ff3366, #ff6633);
  border: none;
  border-radius: 42rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.pred-warn-share-btn::after { border: none; }

.pred-warn-skip {
  padding: 12rpx 40rpx;
}

.pred-warn-skip text {
  font-size: 24rpx;
  color: #666;
}
