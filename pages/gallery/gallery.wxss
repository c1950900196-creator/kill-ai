.page-container {
  min-height: 100vh;
  background: #0a0a0f;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 24rpx;
}

.nav-back {
  color: #666;
  font-size: 32rpx;
  padding: 12rpx 20rpx;
}

.nav-title {
  font-size: 34rpx;
  font-family: 'Courier New', monospace;
  letter-spacing: 4rpx;
}

.nav-placeholder { width: 80rpx; }

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon { font-size: 120rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #666; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #444; }

.gallery-list {
  flex: 1;
  padding: 0 24rpx 40rpx;
}

.gallery-card {
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-chaos {
  font-size: 28rpx;
  font-weight: bold;
  font-family: 'Courier New', monospace;
}

.card-time { font-size: 22rpx; }

.card-highlight {
  background: #1a1a0a;
  border: 1rpx solid #ffee0022;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.highlight-label { font-size: 22rpx; }
.highlight-text { font-size: 26rpx; color: #e0e0e0; }

.card-messages {
  margin-bottom: 16rpx;
  max-height: 300rpx;
  overflow: hidden;
}

.mini-msg {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  display: flex;
}

.mini-role {
  font-weight: bold;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.mini-text {
  color: #aaa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.card-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.delete-btn {
  color: #ff336688;
  border-color: #ff336622;
}
