.page-container {
  min-height: 100vh;
  background: #0a0a0f;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 24rpx;
}

.nav-back { color: #666; font-size: 32rpx; padding: 12rpx 20rpx; }
.nav-title { font-size: 34rpx; font-family: 'Courier New', monospace; letter-spacing: 4rpx; }
.nav-placeholder { width: 80rpx; }

.settings-list {
  padding: 0 24rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.setting-info {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-name {
  font-size: 30rpx;
  color: #e0e0e0;
}

.setting-arrow {
  font-size: 28rpx;
}

/* 分享配置 */
.share-config-section {
  padding: 32rpx 24rpx 0;
}

.section-title {
  font-size: 28rpx;
  color: #e0e0e0;
  font-family: 'Courier New', monospace;
  display: block;
  margin-bottom: 16rpx;
}

.share-texts {
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.share-label {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.share-text-list {
  margin-bottom: 12rpx;
}

.share-text-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.share-text-input {
  flex: 1;
  height: 68rpx;
  background: #1a1a2e;
  border: 1rpx solid #2a2a3e;
  border-radius: 10rpx;
  padding: 0 20rpx;
  color: #e0e0e0;
  font-size: 26rpx;
}

.share-text-del {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f87171;
  font-size: 28rpx;
  background: rgba(248, 113, 113, 0.1);
  border-radius: 10rpx;
}

.share-text-add {
  text-align: center;
  padding: 12rpx;
}

.share-text-add text {
  font-size: 24rpx;
  color: #00e5ff;
  font-family: 'Courier New', monospace;
}

.share-image {
  padding: 24rpx;
  margin-bottom: 12rpx;
}

.share-image-preview {
  width: 400rpx;
  height: 320rpx;
  margin: 16rpx auto;
  border: 2rpx dashed #2a2a3e;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-img {
  width: 100%;
  height: 100%;
}

.share-img-placeholder {
  text-align: center;
}

.share-img-placeholder text {
  font-size: 24rpx;
  color: #666;
}

.share-image-clear {
  text-align: center;
  padding: 12rpx;
}

.share-image-clear text {
  font-size: 22rpx;
  color: #f87171;
}

.share-save-btn {
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #00e5ff, #00ff88);
  border: none;
  border-radius: 40rpx;
  color: #0a0a0f;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.share-save-btn::after { border: none; }

.about-section {
  padding: 40rpx 24rpx;
  margin-top: auto;
}

.about-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.about-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'Courier New', monospace;
}

.about-ver {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
  font-family: 'Courier New', monospace;
}

.about-desc {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 8rpx;
}

.about-divider {
  height: 1rpx;
  background: #1e1e2e;
  margin: 24rpx 0;
}

.about-copy {
  font-size: 20rpx;
  display: block;
  margin-bottom: 4rpx;
  font-family: 'Courier New', monospace;
}
