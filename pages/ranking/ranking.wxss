.page-container {
  min-height: 100vh;
  background: #0a0a0f;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 32rpx 24rpx;
}

.nav-back { color: #666; font-size: 32rpx; padding: 12rpx 20rpx; }
.nav-title { font-size: 34rpx; font-family: 'Courier New', monospace; letter-spacing: 4rpx; }
.nav-placeholder { width: 80rpx; }

.rank-notice {
  text-align: center;
  padding: 12rpx 0;
  margin: 0 24rpx 16rpx;
}

.rank-notice-text {
  font-size: 22rpx;
  color: #f87171;
  font-family: 'Courier New', monospace;
  border: 1rpx solid rgba(248, 113, 113, 0.3);
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(248, 113, 113, 0.06);
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  margin: 0 24rpx 24rpx;
  background: #12121a;
  border-radius: 12rpx;
  padding: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
  font-family: 'Courier New', monospace;
  transition: all 0.3s;
}

.tab-item.active {
  background: #00ff8822;
  color: #00ff88;
}

/* 我的排名 */
.my-rank {
  margin: 0 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.my-rank-label { font-size: 24rpx; color: #888; }
.my-rank-num { font-size: 36rpx; font-weight: bold; font-family: 'Courier New', monospace; }
.my-rank-score { font-size: 24rpx; color: #aaa; }

/* 排行列表 */
.rank-list {
  flex: 1;
  padding: 0 24rpx 40rpx;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text { font-size: 28rpx; color: #666; display: block; }
.empty-hint { font-size: 24rpx; color: #444; display: block; margin-top: 12rpx; }

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #12121a;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #1e1e2e;
}

.rank-item.top-three {
  border-color: #00ff8822;
}

.rank-pos {
  width: 60rpx;
  text-align: center;
  margin-right: 20rpx;
}

.rank-medal { font-size: 36rpx; }
.rank-num { font-size: 28rpx; }

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  color: #e0e0e0;
  display: block;
}

.rank-time {
  font-size: 20rpx;
  display: block;
  margin-top: 4rpx;
}

.rank-score {
  font-size: 28rpx;
  font-weight: bold;
  font-family: 'Courier New', monospace;
  color: #aaa;
}
